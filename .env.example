# --- Notion connection (server-side only, never exposed to the client) ---
# Full reference, links, and post-deploy checklist: see SETUP.md

# Internal integration token from https://www.notion.so/my-integrations
# The integration must be shared/connected to the databases below
# (in Notion: database ⋯ menu → Connections → add your integration).
NOTION_API_KEY=

# === NEW Community Outreach Intelligence databases (Phase 1+) ===
# Create these three databases and paste their IDs here.
# NOTION_OUTREACH_SESSIONS_DB_ID=
# NOTION_RESPONSES_DB_ID=
# NOTION_FOLLOWUPS_DB_ID=

# === LEGACY databases (preserved during migration) ===
# These remain so historical RSVP and early field records are not lost.
# They will be retired after Deploy 3 once the new model is verified.
NOTION_RSVP_DB_ID=dcea4593a1054d5aab80ea06a38ef503
NOTION_ACTIVITIES_DB_ID=d53844be1a8340eb8f60e54223fa4613
NOTION_PARTICIPANTS_DB_ID=d156bdbc4f6d4650ae0be757fec0b002

# --- Optional staff gate ---
# If set, the field desk requires this passcode before staff can log entries.
# Leave blank to leave the desk open (not recommended for public devices).
REGISTER_PASSCODE=
