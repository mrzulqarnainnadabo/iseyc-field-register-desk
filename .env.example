# --- Notion connection (server-side only, never exposed to the client) ---
# Full reference, links, and post-deploy checklist: see SETUP.md

# Internal integration token from https://www.notion.so/my-integrations
# The integration must be shared/connected to all three databases below
# (in Notion: database ⋯ menu → Connections → add your integration).
NOTION_API_KEY=

# Database IDs — fixed for this programme, from SETUP.md
NOTION_RSVP_DB_ID=dcea4593a1054d5aab80ea06a38ef503
NOTION_ACTIVITIES_DB_ID=d53844be1a8340eb8f60e54223fa4613
NOTION_PARTICIPANTS_DB_ID=d156bdbc4f6d4650ae0be757fec0b002

# --- Optional staff gate ---
# If set, Tab 2 (Field participation) requires this passcode before staff can log entries.
# Leave blank to leave Tab 2 open (not recommended for public devices).
REGISTER_PASSCODE=
